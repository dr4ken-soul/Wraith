  "scripts": {
    "build": "npm run build:contracts && npm run build:keeper && npm run build:web",
    "build:contracts": "npm --prefix contracts run compile",
    "build:keeper": "npm --prefix keeper run build",
    "build:web": "npm --prefix web run build",
